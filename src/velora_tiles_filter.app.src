{application, velora_tiles_filter, [
    {description, "Emergence filter: satellite/aerial imagery tiles, served by velora"},
    {vsn, "0.1.0"},
    {registered, []},
    {mod, {velora_tiles_filter_app, []}},
    {applications, [
        kernel,
        stdlib,
        em_filter
    ]},
    {env, [
        {velora_url, "http://127.0.0.1:8081/agent/query"},
        {tiles_base, "https://velora.roques.me"}
    ]},
    {modules, [
        velora_tiles_filter_app,
        velora_tiles_filter_handler
    ]},
    {licenses, ["Apache-2.0"]},
    {links, [{"GitHub", "https://github.com/EmergenceSystem/velora_tiles_filter"}]}
]}.
